# Careful Mode ortam değişkenleri örneği.
# Kopyalayın: cp .env.example .env   (.env depoya girmez)
# Buradaki değerler örnektir; gerçek şifre ve anahtar asla depoya yazılmaz.

# --- Veritabanı ----------------------------------------------------------------
# PostgreSQL kullanıcısı, şifresi ve veritabanı adı. docker compose bu değerlerle
# veritabanını kurar ve uygulamanın bağlantı adresini (db servisine) kendisi oluşturur.
# Şifre bağlantı adresine girdiği için yalnızca harf ve rakam kullanın
# (örnek üretim: openssl rand -hex 24).
POSTGRES_USER=cyberguard
POSTGRES_PASSWORD=degistir_bunu
POSTGRES_DB=cyberguard

# Yerel geliştirme (npm run dev, prisma komutları) için bağlantı adresi.
# docker compose içinde bu değer kullanılmaz; yukarıdaki üç değerden üretilir.
DATABASE_URL="postgresql://cyberguard:degistir_bunu@localhost:5432/cyberguard?schema=public"

# --- Yayın ---------------------------------------------------------------------
# Sitenin alan adı (örnek: carefulmode.example.com). Caddy HTTPS sertifikasını bunun için alır.
# Boş bırakılırsa localhost kullanılır.
DOMAIN=localhost

# HTTPS'i yığındaki Caddy yapar. Önünde başka bir ters vekil (nginx gibi) olan
# sunucuda bu satır silinir; yayın iş akışının kurduğu sunucu .env'inde yoktur.
COMPOSE_PROFILES=caddy

# --- Hesaplar (Faz 2) -------------------------------------------------------------
# Better Auth oturum imzası: en az 32 karakterlik rastgele değer (openssl rand -hex 32).
# Değişirse herkesin oturumu kapanır. Sunucuda deploy.sh ilk yayında kendisi üretir.
BETTER_AUTH_SECRET=degistir_bunu_en_az_32_karakterlik_rastgele_deger
# Sitenin tam adresi (oturum çerezi ve maildeki bağlantılar). HTTPS adreste çerez "__Secure-" olur.
BETTER_AUTH_URL=http://localhost:3000

# Kod mailleri. RESEND_API_KEY varsa Resend ile gönderilir; yoksa geliştirmede konsola yazılır,
# üretimde gönderilmez. Sunucuda anahtar GitHub depo sırrından gelir (deploy.yml).
# RESEND_API_KEY=
# Gönderen adres; Resend'de doğrulanmış alan adında olmalı.
MAIL_FROM_ADDRESS=no-reply@localhost
# Uçtan uca testler için: mailler bu klasöre JSON olarak yazılır (playwright.config.ts kendisi verir).
# MAIL_OUTBOX_DIR=
# Durum ekranları önizlemesi (/onizleme) yalnızca bu değerle açılır; canlıda yoktur, sayfa 404 olur.
# PREVIEW_PAGE=1

# --- Yönetim paneli (Faz 3) ------------------------------------------------------
# İlk yöneticiler: virgülle ayrılmış e-posta adresleri. Bu adreslerden biriyle kayıt olup
# e-postasını doğrulayan kullanıcı girişte yönetici (ADMIN) olur ve /yonetim'i görür.
# Yöneticilik kendiliğinden geri alınmaz: adres listeden çıksa da yönetici kalır.
# Sunucuda değer GitHub depo değişkeninden (Settings > Variables > ADMIN_EMAILS) gelir (deploy.yml).
# ADMIN_EMAILS=murat@ornek.com,ekip@ornek.com
